        <mxCell id="v1xSEBJivV6I0TZIQxhw-67" parent="v1xSEBJivV6I0TZIQxhw-63" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" value="tipoDocumento" vertex="1">
